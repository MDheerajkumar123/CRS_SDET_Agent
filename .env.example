# ==========================================
# LLM PROVIDERS
# ==========================================

GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Use models available to your free-tier accounts.
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# ==========================================
# APPLICATION
# ==========================================

APP_NAME=CRS SDET AI Agent
ENVIRONMENT=development

# ==========================================
# LLM ROUTING
# ==========================================

CRS_ANALYZER_PROVIDER=gemini
REQUIREMENT_REVIEWER_PROVIDER=openrouter
RISK_STRATEGY_PROVIDER=gemini
SCENARIO_PROVIDER=groq
TEST_DESIGN_PROVIDER=openrouter
TEST_CASE_PROVIDER=gemini
RTM_PROVIDER=groq
FINAL_REVIEWER_PROVIDER=openrouter

# ==========================================
# REVIEW
# ==========================================

MAX_RETRIES=3
# Empty completions are retried conservatively before provider fallback.
MAX_EMPTY_RESPONSE_RETRIES=1
QUALITY_THRESHOLD=85
